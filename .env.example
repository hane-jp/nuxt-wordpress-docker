# Local development example environment variables
# Copy this file to `.env` and adjust values as needed.

# MySQL
MYSQL_DATABASE=wpdb
MYSQL_USER=wpuser
MYSQL_PASSWORD=wppass
MYSQL_ROOT_PASSWORD=rootpass

# Nuxt public runtime config
# WordPress REST API endpoint exposed from the local Docker environment
NUXT_PUBLIC_WP_API_BASE=http://localhost:8080/wp-json
